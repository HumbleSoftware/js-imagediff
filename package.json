{
  "name": "imagediff",
  "main": "./imagediff.js",
  "browser": {
    "canvas": "./browser/canvas.js"
  },
  "description": "JavaScript Canvas based imagediff utility.",
  "homepage": "http://HumbleSoftware.github.com/js-imagediff/",
  "scripts": {
    "build": "node make/build.js",
    "test": "npm run test:node && npm run test:browser",
    "test:browser": "playwright test --config=spec/playwright.config.js",
    "test:node": "jasmine --config=./spec/jasmine.json",
    "test:serve": "node spec/server.js"
  },
  "keywords": [
    "util",
    "server",
    "client",
    "browser",
    "canvas",
    "diff",
    "imagediff"
  ],
  "author": "Carl Sutherland <carl@humblesoftware.com> (http://www.humblesoftware.com/)",
  "contributors": [
    "Jordan Santell <@jsantell>"
  ],
  "optionalDependencies": {
    "canvas": "^3.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jasmine": "^3.5.0",
    "jasmine-core": "^3.99.1",
    "terser": "^5.51.2"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/HumbleSoftware/js-imagediff.git"
  },
  "version": "2.0.0-alpha.1",
  "engines": {
    "node": "^18.12.0 || >=20.9.0"
  },
  "bin": {
    "imagediff": "./bin/imagediff"
  }
}
